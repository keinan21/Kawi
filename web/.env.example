# Salin file ini menjadi .env.local lalu isi nilainya.

# Kunci publishable Clerk (Google OAuth).
# Dashboard Clerk → API Keys → Publishable key.
# Tanpa kunci ini aplikasi menampilkan banner "Mode pengembangan" dan tidak
# merender router (auth, onboard role, dan route terproteksi butuh Clerk).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL API FastAPI (DESIGN.md §5, prefix /api).
# Kosongkan untuk memakai proxy Vite dev; isi http://localhost:8000/api bila
# API berjalan di origin/port lain.
# VITE_API_BASE_URL=   # kosong → pakai proxy Vite dev (default /api, same-origin)