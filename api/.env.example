# Contoh konfigurasi api — salin ke api/.env lalu isi nilai aslinya.
# api/.env sudah masuk .gitignore.

# Kunci secret Clerk, dipakai verifikasi session token + sync webhook (DESIGN.md §5).
CLERK_SECRET_KEY=sk_test_replace_me

# Kunci publishable Clerk, untuk sisi frontend (VITE_CLERK_PUBLISHABLE_KEY).
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Signing secret endpoint webhook Clerk (prefix `whsec_` + base64).
# Dipakai `POST /api/webhooks/clerk` untuk memverifikasi svix-signature.
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Koneksi Neon Postgres, format postgresql+psycopg://USER:PASSWORD@HOST/DB
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/lms

# Base URL LiteLLM proxy lokal untuk development (DESIGN.md §8).
LITELLM_BASE_URL=http://localhost:4000

# Nama model yang dipakai pipeline AI dan Penilaian AI.
MODEL=groq/llama-3.3-70b-versatile

# Folder penyimpanan Unggahan di disk lokal (DESIGN.md §8).
# Path relatif di-resolve relatif repo root, jadi selalu menunjuk var/uploads/.
UPLOAD_DIR=./var/uploads

# Origin frontend yang diizinkan, dipisah koma — HANYA untuk deploy cross-origin
# (web dan API di origin berbeda). Dev via Vite proxy: kosongkan (tidak butuh CORS).
# CORS_ORIGINS=https://app.example.com
